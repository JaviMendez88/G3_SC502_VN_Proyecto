RewriteEngine On

# Habilitar CORS
Header always set Access-Control-Allow-Origin "*"
Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"

# Manejo de preflight requests
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# Redireccionar todas las rutas API a los archivos correspondientes
RewriteRule ^api/register/?$ api/register.php [L,QSA]
RewriteRule ^api/login/?$ api/login.php [L,QSA]
RewriteRule ^api/user/?$ api/user.php [L,QSA]
RewriteRule ^api/movements/?$ api/movements.php [L,QSA]
RewriteRule ^api/dashboard/?$ api/dashboard.php [L,QSA]
RewriteRule ^api/categories/?$ api/categories.php [L,QSA]
RewriteRule ^api/recommendations/?$ api/recommendations.php [L,QSA]
RewriteRule ^api/stats/?$ api/stats.php [L,QSA]

# Bloquear acceso directo a archivos de configuración
<Files "*.php">
    Order Allow,Deny
    Allow from all
</Files>

<Files "config/*">
    Order Deny,Allow
    Deny from all
</Files>

<Files "utils/*">
    Order Deny,Allow
    Deny from all
</Files>

<Files "models/*">
    Order Deny,Allow
    Deny from all
</Files>

# Solo permitir acceso a la carpeta api
<Directory "api">
    Order Allow,Deny
    Allow from all
</Directory>